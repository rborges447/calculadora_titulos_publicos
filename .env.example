# Raiz do projeto (data_root do bbdb.update)
BBDB_DATA_ROOT=Z:\Chila\projetos\calculadora_titulos_publicos

# SQLite materializado pelo pipeline bbdb
BBDB_DB_PATH=Z:\Chila\projetos\calculadora_titulos_publicos\database\app.db

# Excel estático (backup operacional)
BACKUP_EXCEL_DIR=Z:\Chila\projetos\calculadora_titulos_publicos\titulospub\dados\backup_excel

# VariaveisMercado: fallback via scraping se DB indisponível (requer rede; default desligado)
# VM_ALLOW_SCRAPING_FALLBACK=1

# Persistir pickles em titulospub/dados/cache_data/ (default 1; produção multi-worker pode usar 0)
# VM_PERSIST_DISK_CACHE=1
